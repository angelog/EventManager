# Conexão com o PostgreSQL (mesmas credenciais do docker-compose.yml)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/eventmanager"

# Porta em que a API sobe
PORT=3333

# Ambiente: development | test | production
NODE_ENV=development

# Segredo usado para assinar os tokens JWT (obrigatório — troque em produção)
JWT_SECRET="dev-secret-change-me"

# Tempo de expiração do token (ex.: 7d, 12h, 3600)
JWT_EXPIRES_IN="7d"
